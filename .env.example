# Airtable: Personal Access Token with data.records:write on the target base(s)
AIRTABLE_TOKEN=
# Default destination for every plan
AIRTABLE_BASE_ID=appsmbcbhmqEJfMjO
AIRTABLE_TABLE=tblKJobPkoXIaBSyl
# Optional per-plan overrides (BEACON, PIPELINE, FULLBORE, CONTROLROOM)
# AIRTABLE_BASE_ID_PIPELINE=
# AIRTABLE_TABLE_PIPELINE=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=          # must be a verified sender / authenticated domain
SENDGRID_FROM_NAME=FieldForge Partners
NOTIFY_TO_EMAIL=              # comma-separated internal recipients

# Promo deadline (ISO 8601). Default: Mon Nov 30 2026 11:59:59 PM Pacific
# PROMO_ENDS_AT=2026-12-01T07:59:59Z
